{
  "name": "tasklog-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "fastify": "^5.12.0",
    "imapflow": "2.4.0",
    "mailparser": "3.9.43",
    "openid-client": "^6.8.0",
    "pg": "^8.23.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.6",
    "@types/node": "^22.10.0",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.23.0",
    "hoodiecrow-imap": "3.3.1",
    "oidc-provider": "^9.12.2",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
