# Copy to .env and fill in. Never commit .env.

# Database password (used by docker-compose for both containers)
POSTGRES_PASSWORD=change-me

# Address under which Tasklog is reachable (webhook URL, monitor link and OIDC redirect are built from it)
PUBLIC_URL=https://tasks.example.com

# Signs the short-lived login cookie; at least 32 random characters, e.g. `openssl rand -base64 48`
COOKIE_SECRET=

# Login: `oidc` (production) or `dev` (everyone is admin – local development only!)
AUTH_MODE=oidc
OIDC_ISSUER=https://auth.example.com/realms/home
OIDC_CLIENT_ID=tasklog
OIDC_CLIENT_SECRET=
# Claim with the group list (Keycloak: "groups", Authentik: "groups", Authelia: "groups")
OIDC_GROUPS_CLAIM=groups
OIDC_SCOPES=openid profile email groups
# This e-mail is always admin, to get in before the group mapping exists
BOOTSTRAP_ADMIN_EMAIL=

# Home Assistant (can also be set in the admin UI under Home Assistant → Verbindung)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

TZ=Europe/Berlin
# Demo data on an empty database (true/false)
SEED_DEMO=false
